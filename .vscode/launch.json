{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MeshLab (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/src/distrib/Debug/meshlab.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/src/distrib/Debug",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/Users/alirz/Projects/vcpkg/vcpkg_installed/x64-windows/debug/bin;C:/Users/alirz/Projects/vcpkg/vcpkg_installed/x64-windows/bin;${env:PATH}"
        }
      ],
      "console": "internalConsole",
      "stopAtEntry": false,
      "preLaunchTask": "CMake: Build Debug",
      "visualizerFile": "${workspaceFolder}/.vscode/meshlab.natvis"
    },
    {
      "name": "MeshLab (Release)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/src/distrib/Release/meshlab.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/src/distrib/Release",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/Users/alirz/Projects/vcpkg/vcpkg_installed/x64-windows/bin;${env:PATH}"
        }
      ],
      "console": "internalConsole",
      "stopAtEntry": false,
      "preLaunchTask": "CMake: Build Release"
    },
    {
      "name": "MeshLab (Debug, attach)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
